<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Showreel Badge</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0a0a;
  }
  *{ box-sizing:border-box; }
  html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    background:var(--bg);
    overflow:hidden;
  }

  /* page grid, just for context so the badge has somewhere to sit */
  .page{
    position:fixed;
    inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:42px 42px;
  }

  /* ---------- bottom-left rotating showreel badge ---------- */
  .badge{
    position:fixed;
    left:0;
    bottom:0;
    width:360px;
    height:360px;
    /* anchor the badge's center just past the corner so only its
       upper-right arc is visible in the viewport, like the reference */
    transform:translate(-42%, 42%);
    z-index:60;
  }

  .badge .thumb{
    position:absolute;
    left:50%;
    top:50%;
    width:230px;
    height:230px;
    border-radius:34px;
    overflow:hidden;
    /* the source art sits at a slight counter-clockwise tilt, not axis-aligned */
    transform:translate(-50%,-50%) rotate(-15deg);
    box-shadow:
      0 30px 60px -10px rgba(0,0,0,0.55),
      0 0 0 1px rgba(255,255,255,0.03);
    background:#eaff8f;
  }
  .badge .thumb .art{
    position:absolute;
    inset:-20%;
    width:140%;
    height:140%;
  }
  .badge .thumb .blob{
    position:absolute;
    border-radius:50%;
    filter:blur(0px);
  }
  .badge .thumb .blob.green{
    left:6%;
    top:30%;
    width:62%;
    height:62%;
    background:radial-gradient(circle at 35% 35%, #eafff0 0%, #6be89a 30%, #1fae6e 62%, #0a4a30 100%);
    animation:drift-a 9s ease-in-out infinite;
  }
  .badge .thumb .blob.orange{
    left:34%;
    top:26%;
    width:64%;
    height:64%;
    background:radial-gradient(circle at 60% 32%, #fff3c4 0%, #ff9a3c 28%, #e8483c 58%, #7a1030 100%);
    mix-blend-mode:normal;
    animation:drift-b 11s ease-in-out infinite;
  }
  .badge .thumb .hole{
    position:absolute;
    left:50%;
    top:50%;
    width:30%;
    height:30%;
    border-radius:50%;
    background:#0a0a0a;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12);
    transform:translate(-50%,-50%);
    animation:hole-drift 10s ease-in-out infinite;
  }
  @keyframes drift-a{
    0%,100%{ transform:translate(0,0) scale(1); }
    50%{ transform:translate(3%,-4%) scale(1.05); }
  }
  @keyframes drift-b{
    0%,100%{ transform:translate(0,0) scale(1); }
    50%{ transform:translate(-4%,3%) scale(1.04); }
  }
  @keyframes hole-drift{
    0%,100%{ transform:translate(-50%,-50%) scale(1); }
    50%{ transform:translate(-52%,-48%) scale(0.96); }
  }

  .badge .ring{
    position:absolute;
    inset:0;
    transform-origin:180px 180px;
    will-change:transform;
  }
  .badge .ring text{
    fill:#f2f1ec;
    font-family:'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-weight:400;
    font-size:20px;
    letter-spacing:0.5px;
  }
</style>
</head>
<body>

  <div class="page"></div>

  <div class="badge">
    <svg class="ring" viewBox="0 0 360 360">
      <defs>
        <path id="ringPath" d="M 180,180 m -154,0 a 154,154 0 1,1 308,0 a 154,154 0 1,1 -308,0"/>
      </defs>
      <text>
        <textPath href="#ringPath" startOffset="0%">
          showreel&#8194;•&#8194;2025&#8194;•&#8194;showreel&#8194;•&#8194;2025&#8194;•&#8194;
        </textPath>
      </text>
    </svg>
    <div class="thumb">
      <div class="art">
        <div class="blob green"></div>
        <div class="blob orange"></div>
        <div class="hole"></div>
      </div>
    </div>
  </div>


<script>
  // Drive the ring's rotation with requestAnimationFrame rather than a CSS
  // keyframe animation, so the text revolves around the card in a perfectly
  // smooth, continuous loop (no restart jump, no easing hitches).
  const ring = document.querySelector('.badge .ring');
  const ROTATION_PERIOD_MS = 28000; // one full revolution
  let angle = 0;
  let lastT = null;

  function spin(now){
    if (lastT !== null){
      const dt = now - lastT;
      // counter-clockwise, matching the reference footage
      angle -= (360 / ROTATION_PERIOD_MS) * dt;
      if (angle <= -360) angle += 360;
    }
    lastT = now;
    ring.style.transform = `rotate(${angle}deg)`;
    requestAnimationFrame(spin);
  }
  requestAnimationFrame(spin);
</script>
</body>
</html>
