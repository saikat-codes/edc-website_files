<script>
  // ======================================================================
  // CUSTOM CURSOR — a ring that follows quickly and a dot that trails
  // with more delay, both smoothed via linear interpolation (lerp).
  // ======================================================================
  const ring = document.getElementById('cursorRing');
  const dot  = document.getElementById('cursorDot');

  let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
  let ringX = mouseX, ringY = mouseY;
  let dotX  = mouseX, dotY  = mouseY;
  let cursorActive = false;

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (!cursorActive) {
      cursorActive = true;
      ring.classList.add('active');
      dot.classList.add('active');
      ringX = dotX = mouseX;
      ringY = dotY = mouseY;
    }
  });
  window.addEventListener('mouseleave', () => {
    cursorActive = false;
    ring.classList.remove('active');
    dot.classList.remove('active');
  });

  function animateCursor() {
    // ring follows fast, dot follows with a longer lag (spring-ish trail)
    ringX += (mouseX - ringX) * 0.22;
    ringY += (mouseY - ringY) * 0.22;
    dotX  += (mouseX - dotX)  * 0.12;
    dotY  += (mouseY - dotY)  * 0.12;

    ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%,-50%)`;
    dot.style.transform  = `translate(${dotX}px, ${dotY}px) translate(-50%,-50%)`;

    requestAnimationFrame(animateCursor);
  }
  animateCursor();

  // hover state on interactive elements
  document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => {
      ring.classList.add('hovering');
      dot.classList.add('hovering');
    });
    el.addEventListener('mouseleave', () => {
      ring.classList.remove('hovering');
      dot.classList.remove('hovering');
    });
  });

  // ======================================================================
  // NAVBAR — collapses into a "loading dots" indicator while the user is
  // actively scrolling, then expands back showing the active section
  // (scrollspy) once scrolling settles.
  // ======================================================================
  const navbar   = document.getElementById('navbar');
  const navLinks = document.querySelectorAll('#navLinks a');
  const runner   = document.getElementById('runner');
  const sections = document.querySelectorAll('section[id]');
  const heroSection = document.getElementById('hero');

  let scrollTimeout = null;
  let runnerInterval = null;
  const dotPositions = [0, 16, 32, 48, 64]; // left offsets for the 5 dots (px)
  let runnerStep = 0;

  function startRunner() {
    if (runnerInterval) return;
    runnerStep = 0;
    runnerInterval = setInterval(() => {
      runner.style.left = dotPositions[runnerStep] + 'px';
      runnerStep = (runnerStep + 1) % dotPositions.length;
    }, 260);
  }
  function stopRunner() {
    clearInterval(runnerInterval);
    runnerInterval = null;
  }

  function updateActiveLink() {
    const refPoint = window.scrollY + 130; // account for fixed navbar offset
    let currentId = null;
    sections.forEach(sec => {
      if (sec.id === 'hero' || sec.id === 'faq') return;
      if (refPoint >= sec.offsetTop) currentId = sec.id;
    });
    navLinks.forEach(link => {
      link.classList.toggle('active', link.dataset.target === currentId);
    });
  }

  function updateNavTheme() {
    // switch navbar shadow style when it sits above a dark section
    const refPoint = window.scrollY + 60;
    let onDark = false;
    sections.forEach(sec => {
      const top = sec.offsetTop, bottom = top + sec.offsetHeight;
      if (refPoint >= top && refPoint < bottom && sec.classList.contains('dark')) {
        onDark = true;
      }
    });
    navbar.classList.toggle('on-dark', onDark);
  }

  window.addEventListener('scroll', () => {
    updateNavTheme();

    if (!navbar.classList.contains('condensed')) {
      navbar.classList.add('condensed');
      startRunner();
    }

    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      navbar.classList.remove('condensed');
      stopRunner();
      updateActiveLink();
    }, 220);
  }, { passive: true });

  // smooth scroll for nav links
  document.querySelectorAll('.nav-links a').forEach(a => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById(a.dataset.target);
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  updateActiveLink();
  updateNavTheme();
</script>
</body>
</html>na