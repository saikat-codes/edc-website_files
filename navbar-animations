<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Umano — Navbar Recreation</title>
<style>
  /* ============================= RESET ============================= */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    background: #f4f3ef;
    color: #14141f;
    overflow-x: hidden;
    cursor: none; /* replaced by custom cursor */
  }
  a { text-decoration: none; color: inherit; }
  ul { list-style: none; }

  /* ============================= CUSTOM CURSOR ============================= */
  .cursor-ring, .cursor-dot {
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 9999;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    will-change: transform;
  }
  .cursor-ring {
    width: 34px; height: 34px;
    border: 1.5px solid #fb6a2e;
    opacity: 0;
    transition: opacity .25s ease, width .2s ease, height .2s ease, border-color .2s ease, background .2s ease;
  }
  .cursor-dot {
    width: 8px; height: 8px;
    background: #fb6a2e;
    opacity: 0;
    transition: opacity .25s ease, width .2s ease, height .2s ease;
  }
  .cursor-ring.active, .cursor-dot.active { opacity: 1; }
  .cursor-ring.hovering {
    width: 52px; height: 52px;
    background: rgba(251,106,46,0.08);
    border-color: rgba(251,106,46,0.55);
  }
  .cursor-dot.hovering { width: 6px; height: 6px; }

  @media (hover: none), (pointer: coarse) {
    .cursor-ring, .cursor-dot { display: none; }
    body { cursor: auto; }
  }

  /* ============================= NAVBAR ============================= */
  .navbar {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 20px;
    background: #efefef;
    border-radius: 999px;
    padding: 10px 10px 10px 26px;
    box-shadow: 0 10px 30px rgba(15,15,25,0.08), 0 2px 6px rgba(15,15,25,0.04);
    transition: background .35s ease, padding .45s cubic-bezier(.65,0,.35,1), gap .45s cubic-bezier(.65,0,.35,1), box-shadow .35s ease;
  }
  .navbar.condensed {
    padding: 10px 10px 10px 22px;
    gap: 14px;
  }
  .navbar.on-dark {
    background: #f6f6f3;
    box-shadow: 0 14px 38px rgba(0,0,0,0.35), 0 2px 8px rgba(0,0,0,0.15);
  }

  /* --- logo --- */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.5px;
    white-space: nowrap;
    color: #14141f;
  }
  .nav-logo .mark {
    position: relative;
    width: 14px;
    height: 18px;
    flex-shrink: 0;
  }
  .nav-logo .mark::before,
  .nav-logo .mark::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    background: #14141f;
  }
  .nav-logo .mark::before {
    top: 0;
    transform: rotate(-45deg);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .nav-logo .mark::after {
    bottom: 0;
    left: 0;
    width: 14px;
    height: 8px;
    border-radius: 0 0 8px 8px / 0 0 8px 8px;
    background: #14141f;
  }

  /* --- center: links / dots swap zone --- */
  .nav-center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    max-width: 480px;
    transition: max-width .45s cubic-bezier(.65,0,.35,1);
  }
  .navbar.condensed .nav-center { max-width: 70px; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    white-space: nowrap;
    opacity: 1;
    transition: opacity .25s ease .1s;
  }
  .navbar.condensed .nav-links { opacity: 0; pointer-events: none; transition: opacity .15s ease; }

  .nav-links a {
    position: relative;
    font-weight: 600;
    font-size: 15px;
    color: #14141f;
    padding: 4px 2px;
    transition: color .3s ease;
  }
  .nav-links a.active { color: #fb6a2e; }
  .nav-links a:hover { color: #fb6a2e; }

  /* --- loading dots (shown while scrolling) --- */
  .nav-dots {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transition: opacity .2s ease;
  }
  .navbar.condensed .nav-dots { opacity: 1; transition: opacity .25s ease .15s; }

  .nav-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #c7c7c7;
  }
  .nav-dots .runner {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 7px;
    border-radius: 999px;
    background: #14141f;
    transform: translateY(-50%);
    transition: left .28s cubic-bezier(.55,0,.45,1);
  }

  /* --- CTA button --- */
  .nav-cta {
    background: #fb6a2e;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    padding: 12px 24px;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    box-shadow: 0 6px 16px rgba(251,106,46,0.35);
  }
  .nav-cta:hover {
    background: #ff7b41;
    transform: translateY(-1px) scale(1.03);
  }

  /* ============================= LAYOUT / SECTIONS ============================= */
  section {
    position: relative;
    padding: 160px 8vw 120px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .light { background: #f4f3ef; color: #14141f; }
  .dark  { background: #0d1017; color: #f4f3ef; }

  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #fb6a2e;
    margin-bottom: 18px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 76px);
    font-weight: 800;
    line-height: 1.05;
    max-width: 900px;
    letter-spacing: -1px;
  }
  h2 {
    font-size: clamp(30px, 4.5vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    max-width: 760px;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
  }
  p.lead {
    font-size: 19px;
    line-height: 1.6;
    max-width: 560px;
    opacity: 0.75;
    margin-top: 22px;
  }

  /* hero decoration */
  .hero { overflow: hidden; }
  .hero-circle {
    position: absolute;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff8a52, #fb6a2e 55%, #e0501c 100%);
    right: -180px;
    bottom: -220px;
    filter: blur(0px);
    opacity: 0.95;
  }
  .hero-inner { position: relative; z-index: 2; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px,1fr));
    gap: 24px;
    margin-top: 50px;
    max-width: 1000px;
  }
  .card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    padding: 28px;
  }
  .light .card { background: #fff; border-color: rgba(0,0,0,0.06); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
  .card h3 { font-size: 19px; margin-bottom: 10px; font-weight: 700; }
  .card p { font-size: 15px; opacity: 0.7; line-height: 1.55; }

  .faq-item {
    max-width: 720px;
    padding: 26px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .faq-item h3 { font-size: 20px; font-weight: 700; margin-bottom: 10px; }
  .faq-item p { opacity: 0.65; line-height: 1.6; }

  footer {
    background: #0d1017;
    color: #f4f3ef;
    padding: 60px 8vw;
    text-align: center;
    opacity: 0.6;
    font-size: 14px;
  }
</style>
</head>
<body>

  <!-- ============================= CUSTOM CURSOR ============================= -->
